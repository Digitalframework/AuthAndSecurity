# Copy to .env (git-ignored) and fill in the values, or export these as real
# environment variables instead. This file is imported as a properties file at
# startup, so Spring property names work directly.

# --- Google OAuth2 login (required: the app will not start without these) -----
# From the Google Cloud Console.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# --- SMTP, for the emailed sign-in link --------------------------------------
# Leave every one of these commented out and sign-in links are written to the app
# log instead of emailed, which is enough to click through the flow locally.
# Uncommenting spring.mail.host is what switches on real delivery.
#
# Gmail needs an App Password, not your account password, and only issues one
# once 2-Step Verification is on.
#spring.mail.host=smtp.gmail.com
#spring.mail.port=587
#spring.mail.username=you@gmail.com
#spring.mail.password=your-16-character-app-password
#spring.mail.properties.mail.smtp.auth=true
#spring.mail.properties.mail.smtp.starttls.enable=true

# From address on the emails. Defaults to spring.mail.username.
#app.ott.from=you@gmail.com

# Absolute base URL the emailed links point at. Unset, the link is built from the
# incoming request — fine locally, wrong behind a proxy that sends no forwarded
# headers, where it would name a host the recipient cannot reach.
#app.ott.base-url=https://app.example.com

# --- Who may sign in ----------------------------------------------------------
# Both unset means anyone with a working mailbox can sign in. Set either list and
# everyone else is turned away (the response looks identical to them, so the
# endpoint cannot be used to probe who has access). Index the entries to add more.
#app.ott.allowed-emails[0]=sam@example.com
#app.ott.allowed-emails[1]=rin@example.com
#app.ott.allowed-domains[0]=example.com