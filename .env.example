# Copy to .env (git-ignored) and fill in the values, or export these as real
# environment variables instead. This file is imported as a properties file at
# startup, so Spring property names work directly.

# --- Database (required: the app will not start without DB_PASSWORD) ---------
# PostgreSQL. Host, port, database and user default to a stock local install
# (localhost:5432/Security, user postgres) and only need overriding if yours
# differs; the password has no default and must be set here or in the real
# environment.
DB_PASSWORD=your-postgres-password
#DB_HOST=localhost
#DB_PORT=5432
#DB_NAME=Security
#DB_USER=postgres

# --- Google OAuth2 login (required: the app will not start without these) -----
# From the Google Cloud Console.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# --- SMTP, for the emailed sign-in link --------------------------------------
# Leave every one of these commented out and sign-in links are written to the app
# log instead of emailed, which is enough to click through the flow locally.
# Uncommenting spring.mail.host is what switches on real delivery.
#
# Gmail needs an App Password, not your account password, and only issues one
# once 2-Step Verification is on.
#spring.mail.host=smtp.gmail.com
#spring.mail.port=587
#spring.mail.username=you@gmail.com
#spring.mail.password=your-16-character-app-password
#spring.mail.properties.mail.smtp.auth=true
#spring.mail.properties.mail.smtp.starttls.enable=true

# From address on the emails. Defaults to spring.mail.username.
#app.ott.from=you@gmail.com

# Absolute base URL the emailed links point at. Unset, the link is built from the
# incoming request — fine locally, wrong behind a proxy that sends no forwarded
# headers, where it would name a host the recipient cannot reach.
#app.ott.base-url=https://app.example.com

# --- Who may sign in ----------------------------------------------------------
# Both unset means anyone with a working mailbox can sign in. Set either list and
# everyone else is turned away (the response looks identical to them, so the
# endpoint cannot be used to probe who has access). Index the entries to add more.
#app.ott.allowed-emails[0]=sam@example.com
#app.ott.allowed-emails[1]=rin@example.com
#app.ott.allowed-domains[0]=example.com

# --- Buying tokens with PayPal (optional) -------------------------------------
# Leave these blank or commented out and buying tokens is simply off: the buttons
# do not render and the endpoints answer with an error. That is deliberate — an
# unconfigured payment provider must not be a free one.
#
# From developer.paypal.com -> Apps & Credentials -> Sandbox -> Create App.
#app.paypal.client-id=your-sandbox-client-id
#app.paypal.client-secret=your-sandbox-secret

# To actually click through the flow you also need a sandbox *personal* account
# to log in with, under Testing Tools -> Sandbox Accounts. Your real PayPal
# login does not work against the sandbox.
#
# This is a demo and never captures: the order is approved and stops there, so
# no money moves even once real credentials are in place.

# Sandbox by default. Live is https://api-m.paypal.com.
#app.paypal.api-base-url=https://api-m.sandbox.paypal.com

# Absolute base URL PayPal returns the visitor to. Same reasoning as
# app.ott.base-url above: unset, it is built from the incoming request.
#app.paypal.app-base-url=https://app.example.com

# Must be a currency the sandbox business account can accept.
#app.paypal.currency=EUR

# Receiving address. Normally leave this unset — an order is already payable to
# the account that owns the client id above. Naming a different account needs a
# partner arrangement, and a plain REST app that tries it gets the order
# rejected outright.
#app.paypal.payee-email=me@example.com